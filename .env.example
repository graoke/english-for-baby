# Tencent Cloud TTS credentials
# Get these from https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID="your-secret-id"
TENCENT_SECRET_KEY="your-secret-key"

# ── 模型路径配置 ──────────────────────────────────────────────

# Whisper 模型（ASR 语音识别）
# 默认: small（自动从 HuggingFace 下载）
# 可选: tiny, base, small, medium, large-v2, large-v3
# 首次使用会自动下载到指定路径
WHISPER_MODEL_PATH=./data/models/whisper

# MiniCPM GGUF 模型（音素评估）
# 需要手动下载 GGUF 文件放到此目录
MINICPM_GGUF_PATH=./data/models/minicpm-phonetic-evaluator-q4_k_m.gguf

# CORS 允许的来源（逗号分隔）
# 留空则使用开发默认值：localhost:5173,5174,80,8001
# CORS_ORIGINS=http://localhost:80,http://192.168.1.100
